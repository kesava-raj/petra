# Vapi AI Receptionist Configuration
# Obtain your Public Key and Assistant ID from your Vapi Dashboard (https://dashboard.vapi.ai)
VITE_VAPI_PUBLIC_KEY=your_vapi_public_key_here
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# Dedicated Demo Phone Number (E.164 format)
VITE_AGENT_PETTRA_PHONE_NUMBER=+18005557387
VITE_PETRA_PHONE_NUMBER=+18005557387

# Google Sheets Live Lead Capture Webhook (Google Apps Script Web App URL)
# Deploy Apps Script as Web App with access 'Anyone', then paste the exec URL here:
VITE_GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your_google_apps_script_url_here/exec
